# ============================================
# Secure Vault API - Environment Configuration
# Copy this file to .env and fill in real values
# NEVER commit .env to Git!
# ============================================

# --- Database ---
# PostgreSQL connection string
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://vault:vaultpass@localhost:5432/vaultdb

# --- Cache ---
# Redis connection string
# Format: redis://[:password@]host:port
REDIS_URL=redis://:devredis@localhost:6379

# --- JWT Keys (RSA 4096-bit) ---
# Preferred: provide file paths (cleaner and safer than inline PEM in .env)
JWT_PRIVATE_KEY_PATH=secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=secrets/jwt_public.pem

# Optional alternative: inline PEM (single line with \n escapes)
# JWT_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"


# --- CORS ---
# Allowed frontend origin
CORS_ORIGIN=http://localhost:5173

# --- Server ---
PORT=3000

# --- Rate Limiting ---
# Max login attempts per 15 minutes per IP
RATE_LIMIT_LOGIN=5

# --- Storage Quotas ---
# Free tier storage limit in gigabytes
STORAGE_QUOTA_FREE_GB=1

# --- Upload Limits ---
# Max file upload size in megabytes
MAX_UPLOAD_SIZE_MB=100