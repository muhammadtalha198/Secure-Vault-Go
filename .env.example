# ============================================
# Secure Vault API - Environment Configuration
# Copy this file to .env and fill in real values
# NEVER commit .env to Git!
# ============================================

# --- Database ---
# PostgreSQL connection string
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://vault:vaultpass@localhost:5432/vaultdb

# --- Cache ---
# Redis connection string
# Format: redis://[:password@]host:port
REDIS_URL=redis://:devredis@localhost:6379

# --- JWT Keys (RSA 4096-bit) ---
# These will be generated in Step 0.10
# Private key for signing tokens (keep secret!)
JWT_PRIVATE_KEY_PEM=-----BEGIN RSA PRIVATE KEY-----
# ... key content ...
-----END RSA PRIVATE KEY-----

# Public key for verifying tokens (can be shared)
JWT_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----
# ... key content ...
-----END PUBLIC KEY-----

# --- Object Storage (S3/MinIO) ---
S3_BUCKET=vault-docs-dev
S3_REGION=us-east-1
# For local MinIO development:
S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=admin1234

# --- CORS ---
# Allowed frontend origin
CORS_ORIGIN=http://localhost:5173

# --- Server ---
PORT=3000

# --- Rate Limiting ---
# Max login attempts per 15 minutes per IP
RATE_LIMIT_LOGIN=5

# --- Storage Quotas ---
# Free tier storage limit in gigabytes
STORAGE_QUOTA_FREE_GB=1

# --- Upload Limits ---
# Max file upload size in megabytes
MAX_UPLOAD_SIZE_MB=100